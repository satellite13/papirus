{
  "name": "papirus",
  "version": "0.1.0",
  "description": "TypeScript library for building interactive 2D diagrams and flowcharts on HTML Canvas",
  "type": "module",
  "main": "./dist/papirus.js",
  "module": "./dist/papirus.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/papirus.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "serve": "open http://localhost:3000/examples/ && serve -l 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "keywords": [
    "diagram",
    "flowchart",
    "canvas",
    "2d",
    "interactive",
    "typescript"
  ],
  "author": "Nikolay Groznykh <nikolay@groznykh.ru>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://gitverse.ru/ngroznykh/papirus.git"
  },
  "bugs": {
    "url": "https://gitverse.ru/ngroznykh/papirus/issues"
  },
  "homepage": "https://gitverse.ru/ngroznykh/papirus#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.8.0",
    "serve": "^14.2.5",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.32.0",
    "vite": "^7.3.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^4.0.0"
  }
}
